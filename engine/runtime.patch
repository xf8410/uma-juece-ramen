@@ -0,0 +1,39 @@
+//! Portable replay CLI: ramen_runtime <gamedata-dir> <snapshot.json> [seed] [threads] [confirmed-instance].
+use std::{env, fs, path::PathBuf, process::ExitCode};
+use anyhow::{Context, Result, ensure};
+use umaai_runtime::{CancellationToken, RamenSession, initialize, load_config};
+
+/// Run a strict snapshot with explicit data path and reproducible seed.
+fn run() -> Result<()> {
+    let args: Vec<_> = env::args_os().skip(1).collect();
+    ensure!((2..=5).contains(&args.len()), "usage: ramen_runtime <gamedata-dir> <snapshot.json> [seed] [threads] [confirmed-collector-instance]");
+    let data = PathBuf::from(&args[0]);
+    let snapshot = fs::read_to_string(PathBuf::from(&args[1]))?;
+    let seed = args.get(2).map(|s| s.to_string_lossy().parse::<u64>()).transpose()?.unwrap_or(42);
+    let mut config = load_config(&data, None)?;
+    let threads = args.get(3).map(|s| s.to_string_lossy().parse::<usize>()).transpose()?.unwrap_or(config.collector.threads);
+    ensure!(threads > 0, "threads must be positive");
+    config.collector.threads = threads;
+    let pool = rayon::ThreadPoolBuilder::new().num_threads(threads).build()?;
+    initialize(&data, &config)?;
+    let mut session = RamenSession::new(config)?;
+    if let Some(instance) = args.get(4) { session.select_collector_instance(&instance.to_string_lossy())?; }
+    let mut write_failed = false;
+    let result = pool.install(|| session.evaluate_json_with_sink(&snapshot, seed, CancellationToken::new(), &mut |event| {
+        match serde_json::to_string(event) {
+            Ok(line) => println!("{line}"),
+            Err(_) => write_failed = true,
+        }
+    })).context("snapshot evaluation failed")?;
+    ensure!(!write_failed, "event serialization failed");
+    eprintln!("run={} snapshot={} warnings={:?}", result.run_id, result.snapshot_id, result.warnings);
+    Ok(())
+}
+
+/// CLI errors are visible and produce a failing exit status.
+fn main() -> ExitCode {
+    match run() {
+        Ok(()) => ExitCode::SUCCESS,
+        Err(error) => { eprintln!("{error:#}"); ExitCode::FAILURE }
+    }
+}
