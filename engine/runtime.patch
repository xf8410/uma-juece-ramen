@@ -0,0 +1,19 @@
+//! Cooperative cancellation for native callers. Cancellation never returns partial scores.
+use std::sync::{Arc, atomic::{AtomicBool, Ordering}};
+use std::time::{Duration, Instant};
+use anyhow::{Result, ensure};
+/// Cloneable request cancellation handle; deadlines are monotonic.
+#[derive(Clone, Debug, Default)]
+pub struct CancellationToken { cancelled: Arc<AtomicBool>, deadline: Option<Instant> }
+impl CancellationToken {
+    /// Create a token without a deadline.
+    pub fn new() -> Self { Self::default() }
+    /// Attach a deadline to this request.
+    pub fn with_timeout(mut self, timeout: Duration) -> Self { self.deadline = Instant::now().checked_add(timeout); self }
+    /// Signal cancellation from any thread.
+    pub fn cancel(&self) { self.cancelled.store(true, Ordering::Release); }
+    /// Whether explicit cancellation or timeout has occurred.
+    pub fn is_cancelled(&self) -> bool { self.cancelled.load(Ordering::Acquire) || self.deadline.is_some_and(|d| Instant::now() >= d) }
+    /// Return an error on cancellation; never swallow it as a failed rollout.
+    pub fn check(&self) -> Result<()> { ensure!(!self.is_cancelled(), "request_cancelled"); Ok(()) }
+}
