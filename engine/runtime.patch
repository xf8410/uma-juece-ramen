+//! Native review entry point; all analysis and narrative stay on the device.
+use std::path::{Path, PathBuf};
+use anyhow::{Context, Result, ensure};
+use umasim::{game::SupportCard, gamedata::GAMEDATA};
+use crate::{checks, clones, decisions, digest, execution, gdata, inherit, pack, report, schedule, timeline};
+
+/// Analyze a canonical PC/native ZIP and write digest.json and an offline HTML report.
+/// Legacy Android summary JSONL is deliberately not accepted as complete observation history.
+pub fn analyze_pack(zip: &Path, out_dir: &Path, data_dir: &Path) -> Result<PathBuf> {
+    let p = if zip.is_dir() { pack::open_directory(zip)? } else {
+        ensure!(zip.extension().is_some_and(|e| e.eq_ignore_ascii_case("zip")), "review_requires_canonical_zip_or_directory");
+        pack::open_zip(zip)?
+    };
+    ensure!(!p.snaps.is_empty(), "review_no_canonical_snapshots");
+    gdata::init(data_dir)?;
+    let gamedata_ok = true;
+    let gamedata_bundled = gdata::bundled_note(data_dir);
+    // ③ timeline / decisions（§11 步骤 2）
+    let tl = timeline::build(&p.snaps);
+    let dec = decisions::parse(p.decisions_csv.as_deref())?;
+
+    // ④ schedule / 终局评分（§11 步骤 3 + §6.3）
+    let uma_data = if gamedata_ok {
+        p.meta
+            .as_ref()
+            .map(|m| m.uma_id)
+            .or_else(|| tl.first_status.as_ref().map(|s| s.base_game.uma_id))
+            .and_then(|id| GAMEDATA.get().and_then(|g| g.get_uma(id).ok()))
+    } else {
+        None
+    };
+    let race_history: Vec<i32> = tl
+        .last_status
+        .as_ref()
+        .map(|s| s.base_game.race_history.clone())
+        .unwrap_or_default();
+    let last_turn = tl
+        .last_status
+        .as_ref()
+        .map(|s| s.base_game.turn)
+        .unwrap_or(0);
+    let mut sched = schedule::build(uma_data, &race_history, last_turn);
+    // 自选比赛期限波动（用户口径）：>8000 的运气波动通常是「不补赛将育成失败」的
+    // 低估 + 补赛达标后回升，净变≈0 → 进伪波动标记 + 赛程注记（供叙事点出「极限达标」）
+    let swings = checks::free_race_swings(&dec.rows, &sched);
+    for s in &swings {
+        sched.notes.push(checks::free_race_swing_note(s));
+    }
+
+    // ⑤ 实际执行推断（§11 步骤 4、§5.4）+ digest 组装落盘
+    // 必赛回合 ∪ URA 决赛（73/75/77 剧本固定赛）→ 「比赛」判定兜底
+    let mut race_turns = sched.mandatory_turns.clone();
+    race_turns.extend([73, 75, 77]);
+    let exec = execution::build(&tl.rows, &dec.rows, &race_turns);
+
+    // ⑥ 检查项引擎（§11 步骤 5-6）：伪波动标记 / 超级拉面期 / 坏手法 / 继承 / 分身
+    let mut flags = checks::flagged_turns(&tl.rows);
+    flags.extend(checks::free_race_swing_flags(&swings));
+    flags.extend(checks::skill_learned_flags(&tl.rows));
+    flags.sort_by_key(|f| f.turn);
+    flags.dedup();
+    let mut extra_findings: Vec<execution::Finding> = Vec::new();
+    if let Some(stats) = checks::super_ramen_stats(&dec.rows) {
+        extra_findings.push(checks::super_ramen_finding(&stats));
+    }
+    extra_findings.extend(checks::bad_habits(&tl.rows, &exec, &sched, &race_history));
+    let (inherit_ref, inheritance_source) = observed_inheritance(&p)?;
+    let inherit_block = inherit::build(&tl.rows, &exec, inherit_ref);
+    // 分身观测需卡组 cardType（gamedata 缺失 → 整块跳过）
+    let card_types: Option<Vec<i32>> = if gamedata_ok {
+        tl.first_status.as_ref().map(|s| {
+            s.base_game
+                .card_id
+                .iter()
+                .map(|&idrank| SupportCard::new(idrank).map(|c| c.card_type).unwrap_or(-1))
+                .collect()
+        })
+    } else {
+        None
+    };
+    let clones_block = clones::build(&p.snaps, card_types.as_deref(), &exec);
+
+    let inputs = digest::Inputs {
+        pack: &p,
+        timeline: &tl,
+        decisions: &dec,
+        execution: exec.clone(),
+        schedule: sched,
+        gamedata_ok,
+        flags,
+        inherit: Some(inherit_block.clone()),
+        clones: clones_block.clone(),
+        extra_findings: extra_findings.clone(),
+        gamedata_bundled,
+    };
+    let mut d = digest::build(&inputs);
+    crate::recovery::apply(&mut d, &p)?;
+    d.context.criteria.push(inheritance_source.into());
+    if p.meta.as_ref().is_none_or(|m| m.engine_revision.is_none() || m.data_version.is_none() || m.config.is_none()) {
+        d.context.criteria.push("局包缺引擎、数据或配置版本；本报告版本一致性未经确认，原生宿主应拒绝跨版本复盘。".into());
+    }
+    let final_turn_observed = tl.last_status.as_ref().is_some_and(|s| s.base_game.turn == 77);
+    let completed = final_turn_observed && p.meta.as_ref().is_some_and(|m| {
+        m.complete == Some(true) || (m.complete.is_none() && m.end_reason == "game_end")
+    });
+    if !completed {
+        d.meta.final_score = None;
+        d.meta.rank = None;
+        d.context.criteria.push("本局未记录完整终局证据，末次观测不能当作终局评分。".into());
+    }
+    digest::write_json(&d, out_dir)?;
+
+    let narrative = local_narrative(&d);
+    report::render_embedded(&d, out_dir, &narrative)
+}
+
+/// Versioned inheritance belongs to the observed run, never to the currently selected deck/config.
+fn observed_inheritance(pack: &pack::Pack) -> Result<(Option<i32>, &'static str)> {
+    let mut has_v1 = false;
+    let mut observed: Option<[i32; 6]> = None;
+    let mut missing = false;
+    for snap in &pack.snaps {
+        let raw: serde_json::Value = serde_json::from_slice(&snap.bytes)?;
+        if raw.get("runtime_stage").is_none() { continue; }
+        has_v1 = true;
+        let Some(value) = raw.get("runtime_continuation").and_then(|v| v.get("inherit_extra_count")) else { missing = true; continue; };
+        let extras: [i32; 6] = serde_json::from_value(value.clone()).context("runtime_continuation.inherit_extra_count must contain six i32 values")?;
+        ensure!(observed.is_none_or(|previous| previous == extras), "inconsistent observed inheritance within one run");
+        observed = Some(extras);
+    }
+    if has_v1 {
+        if missing || observed.is_none() { return Ok((None, "版本化局包缺少完整runtime_continuation继承观察值，继承参考分缺失，不读取当前配置补造。")); }
+        let extras = observed.context("inheritance observation missing")?;
+        let sum = extras[..5].iter().try_fold(126i32, |sum, value| sum.checked_add(*value)).context("inheritance reference overflow")?;
+        return Ok((Some(sum), "继承参考分来源：本局runtime_continuation.inherit_extra_count的前五项之和加126。"));
+    }
+    Ok((umasim::gamedata::GAMECONFIG.get().map(|c| c.extra_count[..5].iter().sum::<i32>() + 126), "旧PC局包未保存继承观察值，参考分沿用当前配置回退；不保证与原局配置一致。"))
+}
+
+/// Deterministic, factual local narrative; no external LLM or invented causal claims.
+pub fn local_narrative(d: &digest::Digest) -> report::Narrative {
+    let end = d.timeline.last().map(|r| r.turn).unwrap_or(0);
+    let score = d.meta.final_score.map(|x| format!("终局评分：{x}")).unwrap_or_else(|| "尚无完整终局证据，本次为过程复盘".into());
+    let comparable = d.execution.iter().filter(|r| r.matches.is_some()).count();
+    let matched = d.execution.iter().filter(|r| r.matches == Some(true)).count();
+    report::Narrative {
+        overview: format!("<p>本局记录 {} 份快照，覆盖至内部回合 {}。{}。数据不足处以缺失处理。</p>", d.timeline.len(), end, score),
+        luck_trend: format!("<p>共有 {} 条决策记录。运气图按同一引擎的候选终局分计算；网络策略未提供搜索分的决策不作为零分计入。{}</p>", d.decisions.len(),
+            if d.recovery.as_ref().is_some_and(|r| !r.history_complete) { "恢复后的曲线使用独立基线，不能视为整局累计运气。" } else { "" }),
+        findings: format!("<p>规则检查产生 {} 条发现。可比较动作 {} 次，其中 {} 次与推荐一致；未观察到的动作不判为偏离。</p>", d.findings.len(), comparable, matched),
+        summary: "<p>本报告完全本地生成。图表和规则发现描述已记录事实；没有完整快照的阶段不能用于还原真实操作或推断因果。</p>".into(),
+    }
+}
+
