-pub struct LuckScoreTracker {
-    initial_terminal_baseline: Option<f64>,
-    prev_turn_terminal_baseline: Option<f64>,
-    total_luck: f64,
-    last_turn_delta: Option<f64>,
-    last_single_mode_id: Option<u64>
