-    pub fn last_single_mode_id(&self) -> Option<u64> {
-        self.last_single_mode_id
-    }
-
-    /// 把「原期望评分」换算为显示分
-    ///
-    /// `display = raw + (max_turn − turn) × bonus`
-    /// - `initial` 恒走 `turn = 0`
-    /// - `current` 走实际回合 `turn`
-    fn to_display(raw: f64, turn: i32, max_turn: i32, bonus: i32) -> f64 {
-        raw + (max_turn - turn) as f64 * bonus as f64
-    }
