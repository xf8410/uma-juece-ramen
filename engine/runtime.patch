+    /// Recovery needs an explicit handshake and can never reactivate a retired epoch.
+    #[test]
+    fn collector_reconnect_keeps_v1_watermark_and_rejects_epoch_replay() -> Result<()> {
+        let mut checks = Checks::new();
+        let mut gate = CollectorGate::default();
+        gate.check(991, LEGACY_COLLECTOR_INSTANCE, 42)?;
+        gate.commit(991, LEGACY_COLLECTOR_INSTANCE, 42);
+        checks.check(gate.check(991, LEGACY_COLLECTOR_INSTANCE, 1).is_err(), "V1 low sequence remains stale");
+        checks.check(gate.check(991, "boot-a", 1).is_err(), "snapshot cannot implicitly handshake");
+        gate.select("boot-a")?; gate.check(991, "boot-a", 1)?; gate.commit(991, "boot-a", 1);
+        gate.select("boot-b")?; gate.check(991, "boot-b", 1)?; gate.commit(991, "boot-b", 1);
+        checks.check(gate.check(991, "boot-a", 999).is_err(), "high old epoch sequence remains retired");
+        checks.check(gate.select("boot-a").is_err(), "old epoch cannot handshake back");
+        checks.check(gate.check(991, "boot-b", 1).is_err(), "duplicate inside new epoch remains stale");
+        checks.finish()
+    }
+
+    /// V2 adds identity without weakening the original payload completeness boundary.
+    #[test]
+    fn v2_is_separate_and_rejects_incomplete_or_unsafe_identity() -> Result<()> {
+        let mut checks = Checks::new();
+        let mut value = serde_json::to_value(snapshot())?;
+        value["schema_version"] = json!(2); value["collector_instance_id"] = json!("boot-a");
+        checks.check(RamenSnapshotV1::parse(&value.to_string()).is_err(), "V1 parser does not acquire V2 semantics");
+        let parsed = SnapshotEnvelope::parse(&value.to_string())?;
+        checks.check(parsed.schema_version() == 2 && parsed.collector_instance_id() == "boot-a", "V2 identity preserved");
+        for invalid in ["", ".", "..", "a/b", "legacy-v1", "中文"] {
+            value["collector_instance_id"] = json!(invalid);
+            checks.check(SnapshotEnvelope::parse(&value.to_string()).is_err(), "unsafe identity rejected");
+        }
+        value["collector_instance_id"] = json!("boot-a"); value["ready"] = json!(false);
+        checks.check(SnapshotEnvelope::parse(&value.to_string()).is_err(), "V2 does not bypass producer veto");
+        checks.finish()
+    }
