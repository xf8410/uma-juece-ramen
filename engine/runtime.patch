+//! Strict, observable-state-only native API. No synthetic replay and no filesystem reads per request.
+use std::{collections::{HashMap, HashSet}, path::Path, sync::{Arc, Mutex}};
+use anyhow::{Context, Result, ensure};
+use rand::{SeedableRng, rngs::StdRng};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use umasim::{
+    game::{Game, Trainer, ramen::{FeelingType, RamenAction, RamenGame, RamenStage}},
+    gamedata::{EventData, GAMECONFIG, GameConfig, init_global_with_config, set_data_dir},
+    output::{DecisionInfo, DecisionSink, GameView},
+    search::{CancellationToken, SearchConfig},
+    trainer::{RamenMctsTrainer, RamenSearchStages},
+};
+use crate::{
+    decision::{LastReasonSink, LuckScoreTracker, emit_with_luck_decision},
+    protocol::{GameStatus, GameStatusRamen},
+    ramen_nn::{RamenClientTrainer, build_client_trainer},
+    scenario::ramen::{fallback_decision, ramen_stage_kind},
+};
+
+/// Load the developer defaults and optional explicit user override without reading cwd or environment.
+pub fn load_config(data_dir: &Path, override_path: Option<&Path>) -> Result<GameConfig> {
+    let mut config: GameConfig = toml::from_str(&std::fs::read_to_string(data_dir.join("default_config.toml"))?)?;
+    if let Some(path) = override_path {
+        let overrides: umasim::gamedata::OverrideGameConfig = toml::from_str(&std::fs::read_to_string(path)?)?;
+        config = overrides.merge(&config);
+    }
+    umasim::utils::validate_game_config(&config)?;
+    Ok(config)
+}
+
+/// Initialize an immutable process data/config generation without changing the working directory.
+pub fn initialize(data_dir: &Path, config: &GameConfig) -> Result<()> {
+    static INIT: Mutex<()> = Mutex::new(());
+    let _guard = INIT.lock().map_err(|_| anyhow::anyhow!("initialization lock poisoned"))?;
+    if let Some(existing) = GAMECONFIG.get() {
+        ensure!(serde_json::to_value(existing)? == serde_json::to_value(config)?,
+            "config_generation_changed: restart engine to change configuration");
+    }
+    set_data_dir(data_dir)?;
+    init_global_with_config(config)
+}
+
+/// Explicit state missing from the historical PC protocol. All fields must be observed.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct Continuation {
+    /// Number of ramen meals in the current year.
+    pub eat_count: i32,
+    /// Actual completed RMJ results, including failures.
+    pub rmj_results: Vec<bool>,
+    /// Observed permanent RMJ training-level bonus.
+    pub train_level_bonus: i32,
+    /// Selected recipe awaiting a later substep; null means none.
+    pub pending_ramen: Option<usize>,
+    /// Selected hidden-flavor replacement amounts.
+    pub pending_special_targets: [i32; 3],
+    /// Observed inheritance extras; never read from the current directory.
+    pub inherit_extra_count: [i32; 6],
+}
+
+/// Versioned snapshot. `state` uses the existing PC baseGame/ramen field spelling.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct RamenSnapshotV1 {
+    /// Exactly 1.
+    pub schema_version: u32,
+    /// Stable game identity, not the character ID.
+    pub run_id: u64,
+    /// Monotonically increasing within a run; includes substeps.
+    pub snapshot_id: u64,
+    /// Explicit decision phase; no guessing from UI turn counters.
+    pub stage: String,
+    /// Complete observed protocol state.
+    pub state: GameStatusRamen,
+    /// Additional observed state required for simulation.
+    pub continuation: Continuation,
+    /// Explicit event outcomes/probabilities, present only for event phase.
+    pub event: Option<EventData>,
+    /// Collector build, surfaced as provenance.
+    #[serde(default)]
+    pub collector_version: Option<String>,
+    /// Game data build, surfaced as provenance.
+    #[serde(default)]
+    pub game_version: Option<String>,
+    /// Acquisition timestamp; not used for simulation randomness.
+    #[serde(default)]
+    pub captured_at_ms: Option<u64>,
+    /// Collector must list unavailable observations; nonempty rejects evaluation.
+    #[serde(default)]
+    pub missing_fields: Vec<String>,
+    /// Additional acquisition evidence.
+    #[serde(default)]
+    pub provenance: Value,
+    /// Explicit collector readiness; false always rejects search.
+    #[serde(default)]
+    pub ready: Option<bool>,
+    /// When supplied, the collector must attest a coherent capture.
+    #[serde(default)]
+    pub capture_coherence: Option<String>,
+}
+
+/// Require explicit fields even where legacy serde uses defaults (including explicit nulls).
+fn require_keys(value: &Value, keys: &[&str], path: &str, missing: &mut Vec<String>) {
+    for key in keys {
+        if value.get(*key).is_none() { missing.push(format!("{path}.{key}")); }
+    }
+}
+
+/// Reserved identity for unversioned collector processes using the original V1 semantics.
+pub const LEGACY_COLLECTOR_INSTANCE: &str = "legacy-v1";
+
+/// Validate a V2 process identity before using it in transport bindings or archive paths.
+pub fn validate_collector_instance_id(id: &str) -> Result<()> {
+    ensure!(!id.is_empty() && id.len() <= 128 && !matches!(id, "." | ".." | LEGACY_COLLECTOR_INSTANCE)
+        && id.bytes().all(|c| c.is_ascii_alphanumeric() || b"._-".contains(&c)), "invalid_collector_instance_id");
+    Ok(())
+}
+
+/// V2 is a separate wire envelope. Its observed simulation payload has exactly V1's completeness rules.
+#[derive(Debug, Clone)]
+pub struct RamenSnapshotV2 {
+    /// Identity independently confirmed through the collector capabilities endpoint.
+    pub collector_instance_id: String,
+    /// Shared observed payload, internally normalized to V1 for the common importer.
+    pub snapshot: RamenSnapshotV1,
+}
+
+impl RamenSnapshotV2 {
+    /// Parse only V2. Never let the original V1 parser silently acquire epoch reset semantics.
+    pub fn parse(raw: &str) -> Result<Self> {
+        let mut value: Value = serde_json::from_str(raw).context("snapshot JSON")?;
+        ensure!(value["schema_version"] == 2, "unsupported schema_version: expected V2");
+        let instance = value["collector_instance_id"].as_str().context("collector_instance_id missing")?.to_string();
+        validate_collector_instance_id(&instance)?;
+        ensure!(value["snapshot_id"].as_u64().is_some_and(|n| n > 0), "snapshot_id must be positive in V2");
+        value["schema_version"] = json!(1);
+        let snapshot = RamenSnapshotV1::parse(&value.to_string())?;
+        Ok(Self { collector_instance_id: instance, snapshot })
+    }
+}
+
+/// Version-dispatched envelope shared by PC, JNI and offline replay.
+#[derive(Debug, Clone)]
+pub enum SnapshotEnvelope { V1(RamenSnapshotV1), V2(RamenSnapshotV2) }
+
+impl SnapshotEnvelope {
+    /// Parse the explicit wire version; no field-shape or low-sequence heuristic.
+    pub fn parse(raw: &str) -> Result<Self> {
+        let value: Value = serde_json::from_str(raw).context("snapshot JSON")?;
+        match value["schema_version"].as_u64() {
+            Some(1) => Ok(Self::V1(RamenSnapshotV1::parse(raw)?)),
+            Some(2) => Ok(Self::V2(RamenSnapshotV2::parse(raw)?)),
+            _ => anyhow::bail!("unsupported schema_version"),
+        }
+    }
+    /// Original protocol version for response correlation.
+    pub fn schema_version(&self) -> u32 { match self { Self::V1(_) => 1, Self::V2(_) => 2 } }
+    /// Epoch identity; V1 always retains its reserved legacy identity.
+    pub fn collector_instance_id(&self) -> &str {
+        match self { Self::V1(_) => LEGACY_COLLECTOR_INSTANCE, Self::V2(v) => &v.collector_instance_id }
+    }
+    /// Complete observed state imported by the single simulation implementation.
+    pub fn snapshot(&self) -> &RamenSnapshotV1 { match self { Self::V1(v) => v, Self::V2(v) => &v.snapshot } }
+}
+
+/// Explicit handshake gate. Selecting an epoch retires the preceding epoch permanently.
+#[derive(Default)]
+struct CollectorGate {
+    selected: Option<String>,
+    retired: HashSet<String>,
+    watermarks: HashMap<(u64, String), u64>,
+}
+
+impl CollectorGate {
+    /// Caller has independently confirmed capabilities; evaluation itself never calls this.
+    fn select(&mut self, instance: &str) -> Result<bool> {
+        if instance != LEGACY_COLLECTOR_INSTANCE { validate_collector_instance_id(instance)?; }
+        ensure!(!self.retired.contains(instance), "retired_collector_instance");
+        if self.selected.as_deref() == Some(instance) { return Ok(false); }
+        if let Some(previous) = self.selected.replace(instance.into()) { self.retired.insert(previous); }
+        Ok(true)
+    }
+    /// Reject unsolicited epochs and out-of-order snapshots without changing the watermark.
+    fn check(&self, run: u64, instance: &str, seq: u64) -> Result<()> {
+        ensure!(!self.retired.contains(instance), "retired_collector_instance");
+        ensure!(self.selected.as_deref() == Some(instance)
+            || (self.selected.is_none() && instance == LEGACY_COLLECTOR_INSTANCE), "collector_handshake_required");
+        ensure!(self.watermarks.get(&(run, instance.into())).is_none_or(|old| seq > *old),
+            "stale_snapshot: sequence must increase within the confirmed run and collector instance");
+        Ok(())
+    }
+    /// Commit only a fully completed evaluation, after cancellation checks.
+    fn commit(&mut self, run: u64, instance: &str, seq: u64) {
+        if self.selected.is_none() { self.selected = Some(instance.into()); }
+        self.watermarks.insert((run, instance.into()), seq);
+    }
+}
+
+impl RamenSnapshotV1 {
+    /// Parse and validate before touching global game data or constructing a game.
+    pub fn parse(raw: &str) -> Result<Self> {
+        let v: Value = serde_json::from_str(raw).context("snapshot JSON")?;
+        let mut missing = Vec::new();
+        require_keys(&v, &["schema_version", "run_id", "snapshot_id", "stage", "state", "continuation", "event"], "snapshot", &mut missing);
+        let template = serde_json::to_value(GameStatusRamen::default())?;
+        for section in ["baseGame", "ramen"] {
+            if let Some(fields) = template[section].as_object() {
+                for key in fields.keys() {
+                    if v["state"][section].get(key).is_none() { missing.push(format!("state.{section}.{key}")); }
+                }
+            }
+        }
+        require_keys(&v["continuation"], &["eat_count", "rmj_results", "train_level_bonus", "pending_ramen", "pending_special_targets", "inherit_extra_count"], "continuation", &mut missing);
+        if let Some(fields) = v.get("missing_fields").and_then(Value::as_array) {
+            missing.extend(fields.iter().map(|x| x.as_str().unwrap_or("invalid missing_fields item").to_string()));
+        }
+        ensure!(missing.is_empty(), "missing_fields: {}", missing.join(", "));
+        if v["stage"] == "event" {
+            require_keys(&v["event"], &["id", "name", "person_index", "trigger", "player_select", "choices"], "event", &mut missing);
+            if let Some(choices) = v["event"]["choices"].as_array() {
+                for (i, outcomes) in choices.iter().enumerate() {
+                    if let Some(outcomes) = outcomes.as_array() {
+                        for (j, outcome) in outcomes.iter().enumerate() {
+                            let path = format!("event.choices[{i}][{j}]");
+                            require_keys(outcome, &["result", "prob", "value", "add_flags", "remove_flags"], &path, &mut missing);
+                            require_keys(&outcome["value"], &["status_pt", "vital", "max_vital", "motivation", "hint_level", "friendship"], &format!("{path}.value"), &mut missing);
+                        }
+                    }
+                }
+            }
+            ensure!(missing.is_empty(), "missing_fields: {}", missing.join(", "));
+        }
+        let s: Self = serde_json::from_value(v).context("snapshot schema")?;
+        s.validate()?;
+        Ok(s)
+    }
+
+    /// Validate ranges that would otherwise panic or silently normalize missing observations.
+    pub fn validate(&self) -> Result<()> {
+        ensure!(self.ready != Some(false), "snapshot_not_ready");
+        ensure!(self.capture_coherence.as_deref().is_none_or(|v| v == "verified"), "capture_coherence_unverified");
+        ensure!(self.schema_version == 1, "unsupported schema_version");
+        ensure!(self.run_id > 0, "run_id must be a real game identity");
+        ensure!(self.missing_fields.is_empty(), "missing_fields: {:?}", self.missing_fields);
+        let b = &self.state.base_game;
+        ensure!(b.scenario_id == 14, "only ramen scenario 14 is supported");
+        ensure!(b.single_mode_chara_id == Some(self.run_id), "run_id differs from baseGame.single_mode_chara_id");
+        ensure!((0..=77).contains(&b.turn), "turn must be zero-based 0..77");
+        ensure!(b.card_id.len() == 6 && b.persons.len() == 6, "exactly six card/person entries required");
+        ensure!(b.person_distribution.len() == 5, "five training distributions required");
+        ensure!(b.max_vital > 0 && (0..=b.max_vital).contains(&b.vital), "invalid vital");
+        ensure!((1..=5).contains(&b.motivation), "invalid motivation");
+        ensure!((0..=5).contains(&b.friend_outgoing_used), "invalid friend_outgoingUsed");
+        ensure!(b.five_status.iter().zip(b.five_status_limit).all(|(&v, cap)| cap > 0 && v >= 0 && v <= cap), "invalid fiveStatus or fiveStatusLimit");
+        ensure!(b.train_level_count.iter().all(|&x| x >= 0), "invalid training level count");
+        if let Some(story) = &b.story {
+            for outcome in story.choices.iter().flatten() {
+                ensure!(outcome.success_effect_value.as_ref().is_none_or(|v| v.values.len() >= 10)
+                    && outcome.failed_effect_value.as_ref().is_none_or(|v| v.values.len() >= 10), "incomplete legacy story effect vector");
+            }
+        }
+        let r = &self.state.ramen;
+        ensure!(r.feeling_stock.iter().all(|x| (1..=3).contains(x)) && r.feeling_stock.len() <= 10, "invalid feeling_stock queue");
+        ensure!(r.feeling_gauge.iter().all(|x| (0..7).contains(x)), "invalid feeling_gauge");
+        ensure!((0..=4).contains(&r.special_feeling), "invalid special_feeling");
+        ensure!((-1..=2).contains(&r.super_ramen), "invalid super_ramen");
+        ensure!(r.selected_regions.len() == 3 || (b.turn <= 2 && r.selected_regions.is_empty()), "selected_regions must be explicit");
+        ensure!(r.selected_regions.iter().all(|&x| x >= 0), "invalid region id");
+        if b.turn >= 2 && matches!(self.stage.as_str(), "train" | "ramen_select" | "special_select") {
+            ensure!(r.selected_regions.len() == 3 && r.selected_regions[0] != r.selected_regions[1]
+                && r.selected_regions[0] != r.selected_regions[2] && r.selected_regions[1] != r.selected_regions[2], "action phase requires three distinct observed regions");
+        }
+        ensure!(r.train_feeling_type.iter().all(|x| (0..=3).contains(x)), "invalid train_feeling_type");
+        ensure!(self.continuation.eat_count >= 0 && self.continuation.rmj_results.len() <= 3, "invalid continuation counters");
+        ensure!((0..=3).contains(&self.continuation.train_level_bonus), "invalid train_level_bonus");
+        ensure!(self.continuation.pending_special_targets.iter().all(|x| (0..=4).contains(x)), "invalid pending_special_targets");
+        match self.stage.as_str() {
+            "train" | "settlement" => {},
+            "ramen_select" => ensure!((2..=71).contains(&b.turn), "ramen_select outside ramen years"),
+            "region_select" => ensure!([2, 23, 47].contains(&b.turn), "region_select requires turn 2/23/47"),
+            "special_select" => ensure!(self.continuation.pending_ramen.is_some(), "special_select requires pending_ramen"),
+            "super_ramen_select" => ensure!(b.turn == 71, "super_ramen_select requires turn 71"),
+            "event" => {
+                let e = self.event.as_ref().context("event phase requires event data")?;
+                ensure!(!e.choices.is_empty() && e.choices.iter().all(|c| !c.is_empty()), "event choices must be complete");
+                for outcomes in &e.choices {
+                    ensure!(outcomes.iter().all(|o| (0..=100).contains(&o.prob)), "invalid event probability");
+                    ensure!(outcomes.iter().map(|o| o.prob).sum::<i32>() == 100, "observed event probabilities must sum to 100");
+                }
+            },
+            _ => anyhow::bail!("unsupported phase: {}", self.stage),
+        }
+        Ok(())
+    }
+
+    /// Reconstruct strictly from observations; undo historical protocol assumptions.
+    pub fn into_game(&self) -> Result<RamenGame> {
+        self.validate()?;
+        let regions = umasim::gamedata::ramen::RAMENDATA.get().context("runtime not initialized")?.ramen_region_effect.len();
+        ensure!(self.state.ramen.selected_regions.iter().all(|&x| (x as usize) < regions)
+            && self.continuation.pending_ramen.is_none_or(|x| x < regions)
+            && (self.state.ramen.last_ramen == -1 || (self.state.ramen.last_ramen >= 0 && (self.state.ramen.last_ramen as usize) < regions)), "region id outside loaded game data");
+        let mut game = self.state.clone().into_game()?;
+        game.base.inherit.extra_count = self.continuation.inherit_extra_count;
+        game.ramen.rmj_results = self.continuation.rmj_results.clone();
+        game.ramen.train_level_bonus = self.continuation.train_level_bonus;
+        game.ramen.eat_count = self.continuation.eat_count;
+        game.ramen.scenario_pt = self.state.ramen.scenario_pt;
+        game.ramen.feeling_queue = self.state.ramen.feeling_stock.iter().map(|x| match x { 1 => FeelingType::A, 2 => FeelingType::B, _ => FeelingType::C }).collect();
+        game.ramen.pending_ramen = self.continuation.pending_ramen;
+        game.ramen.pending_special_targets = self.continuation.pending_special_targets;
+        game.base.unresolved_events.clear();
+        game.stage = match self.stage.as_str() {
+            "ramen_select" => RamenStage::RamenSelect,
+            "special_select" => RamenStage::SpecialSelect,
+            "region_select" => RamenStage::RegionSelect,
+            "super_ramen_select" => RamenStage::SuperRamenSelect,
+            "settlement" => RamenStage::Settlement,
+            _ => RamenStage::Train,
+        };
+        ensure!(game.base.distribution.iter().flatten().all(|&id| id >= -1 && (id < 0 || (id as usize) < game.persons.len())), "personDistribution index outside observed layout");
+        Ok(game)
+    }
+}
+
+/// Events emitted synchronously as each result becomes available.
+#[derive(Debug, Clone, Serialize)]
+#[serde(tag = "type", rename_all = "snake_case")]
+pub enum RuntimeEvent {
+    /// Request accepted.
+    Started,
+    /// A complete decision, with structured action (null for event choices).
+    Decision { decision: DecisionInfo, view: GameView, action: Option<RamenAction> },
+    /// A deterministic follow-up decision is about to start.
+    NextStep,
+    /// No decision is appropriate for this observed state.
+    Skipped { reason: String },
+    /// Request completed without cancellation.
+    Completed,
+}
+
+/// Complete response; the same events are also available through the streaming callback.
+#[derive(Debug, Clone, Serialize)]
+pub struct Evaluation {
+    /// Protocol version.
+    pub schema_version: u32,
+    /// Confirmed collector epoch, or legacy-v1 for original inputs.
+    pub collector_instance_id: String,
+    /// Game identity.
+    pub run_id: u64,
+    /// Input sequence.
+    pub snapshot_id: u64,
+    /// Provenance warnings, never hidden from native callers.
+    pub warnings: Vec<String>,
+    /// Ordered decision stream.
+    pub events: Vec<RuntimeEvent>,
+}
+
+/// Session owns policy/model/luck state. Callers serialize requests and may cancel from another thread.
+pub struct RamenSession {
+    trainer: RamenClientTrainer,
+    reasons: Arc<LastReasonSink>,
+    luck: LuckScoreTracker,
+    previous: Option<(u64, u64)>,
+    collector: CollectorGate,
+    recovery_baseline: bool,
+    luck_start: Option<(u64, u64)>,
+    previous_turn: Option<i32>,
+}
+
+/// Capture enriched metadata without tying the core to stdout or JNI.
+#[derive(Default)]
+struct Capture(Mutex<Option<DecisionInfo>>);
+impl DecisionSink for Capture {
+    fn emit(&self, info: &DecisionInfo, _view: &GameView) {
+        if let Ok(mut slot) = self.0.lock() { *slot = Some(info.clone()); }
+    }
+}
+
+impl RamenSession {
+    /// Assemble the same MCTS/NN policies as the PC application.
+    pub fn new(config: GameConfig) -> Result<Self> {
+        let initialized = GAMECONFIG.get().context("initialize runtime before creating a session")?;
+        ensure!(serde_json::to_value(initialized)? == serde_json::to_value(&config)?, "config_generation_changed: restart engine to change configuration");
+        let reasons = LastReasonSink::new();
+        let trainer = RamenMctsTrainer::new(SearchConfig::new_game_config(&config))
+            .with_stages(RamenSearchStages::parse(&config.mcts.ramen_search_stages)?)
+            .with_friend_complete_required(config.friend_complete_required)
+            .verbose(false).with_reason_sink(reasons.clone());
+        Ok(Self { trainer: build_client_trainer(&config, trainer)?, reasons, luck: LuckScoreTracker::new(), previous: None,
+            collector: CollectorGate::default(), recovery_baseline: false, luck_start: None, previous_turn: None })
+    }
+
+    /// Select only a process identity confirmed through an independent capabilities/control handshake.
+    /// A new epoch resets the live luck baseline, never the old epoch's sequence watermarks.
+    pub fn select_collector_instance(&mut self, instance: &str) -> Result<()> {
+        let was_selected = self.collector.selected.is_some();
+        if self.collector.select(instance)? {
+            self.recovery_baseline = was_selected;
+            self.luck = LuckScoreTracker::new();
+            self.previous = None;
+            self.luck_start = None;
+            self.previous_turn = None;
+        }
+        Ok(())
+    }
+
+    /// Evaluate a strict snapshot, retaining an ordered response.
+    pub fn evaluate_json(&mut self, raw: &str, seed: u64, cancel: CancellationToken) -> Result<Evaluation> {
+        self.evaluate_json_with_sink(raw, seed, cancel, &mut |_| {})
+    }
+
+    /// Evaluate and publish each decision before computing the next substep.
+    pub fn evaluate_json_with_sink(&mut self, raw: &str, seed: u64, cancel: CancellationToken, sink: &mut dyn FnMut(&RuntimeEvent)) -> Result<Evaluation> {
+        cancel.check()?;
+        let envelope = SnapshotEnvelope::parse(raw)?;
+        let snapshot = envelope.snapshot();
+        let instance = envelope.collector_instance_id();
+        self.collector.check(snapshot.run_id, instance, snapshot.snapshot_id)?;
+        let mut game = snapshot.into_game()?;
+        game.set_rule_master(seed);
+        let mut rng = StdRng::seed_from_u64(seed);
+        self.trainer.set_cancellation(cancel.clone());
+        let same_run = self.previous.is_some_and(|(run, _)| run == snapshot.run_id);
+        // Epoch selection clears `previous`; the source counter is meaningful only inside that confirmed epoch.
+        let sequence_gap = self.previous.is_some_and(|(run, seq)| run == snapshot.run_id
+            && snapshot.snapshot_id.checked_sub(seq) != Some(1));
+        let turn_gap = same_run && self.previous_turn.is_some_and(|turn| snapshot.state.base_game.turn > turn + 1);
+        let history_gap = turn_gap || sequence_gap;
+        let mut next_luck = if history_gap { LuckScoreTracker::new() } else { self.luck.clone() };
+        let partial_history = if same_run { self.recovery_baseline || history_gap } else {
+            snapshot.state.base_game.turn > 0 || (self.previous.is_none() && self.recovery_baseline)
+        };
+        let luck_start = self.luck_start.filter(|(run, _)| *run == snapshot.run_id && !history_gap).map(|(_, seq)| seq).unwrap_or(snapshot.snapshot_id);
+        let mut response = Evaluation { schema_version: envelope.schema_version(), collector_instance_id: instance.into(),
+            run_id: snapshot.run_id, snapshot_id: snapshot.snapshot_id, warnings: Vec::new(), events: Vec::new() };
+        if partial_history { response.warnings.push("luck_baseline_at_recovery: earlier history is not part of this session".into()); }
+        if sequence_gap { response.warnings.push("snapshot_sequence_gap: intermediate observations were not accepted; luck baseline restarted at current complete state".into()); }
+        if snapshot.game_version.as_deref().is_none_or(str::is_empty) { response.warnings.push("game_version_unverified".into()); }
+        if snapshot.collector_version.as_deref().is_none_or(str::is_empty) { response.warnings.push("collector_version_unverified".into()); }
+        let mut emit = |mut event: RuntimeEvent| {
+            if let RuntimeEvent::Decision { decision, .. } = &mut event {
+                let extra = decision.scenario_extra.get_or_insert_with(|| json!({}));
+                extra["schema_version"] = json!(envelope.schema_version());
+                extra["collector_instance_id"] = json!(instance);
+                extra["history_complete"] = json!(!partial_history);
+                extra["luck_scope"] = json!(if partial_history { "recovery_segment" } else { "observed_session" });
+                extra["luck_segment_start_snapshot_id"] = json!(luck_start);
+            }
+            sink(&event); response.events.push(event);
+        };
+        emit(RuntimeEvent::Started);
+        if snapshot.stage == "settlement" {
+            emit(RuntimeEvent::Skipped { reason: "settlement_wait_for_observation".into() });
+        } else if snapshot.stage == "event" {
+            let e = snapshot.event.as_ref().context("event data required")?;
+            let index = self.trainer.select_event_choice(&game, e, &e.choices, &mut rng)?;
+            ensure!(index < e.choices.len(), "invalid event choice from trainer");
+            cancel.check()?;
+            let decision = DecisionInfo { action_index: index, decision_kind: "event".into(), candidate_descriptions: e.choices.iter().enumerate().map(|(i, _)| format!("选项 {}", i + 1)).collect(), scenario_extra: Some(json!({"decision_source":"handwritten_event", "score_type":"none", "event_id":e.id})), ..Default::default() };
+            emit(RuntimeEvent::Decision { decision, view: game.view(), action: None });
+        } else {
+            // Only "do not eat" has no real operation/new observation. Never invent training outcomes.
+            for step in 0..2 {
+                cancel.check()?;
+                let actions = game.list_actions()?;
+                ensure!(!actions.is_empty(), "no legal actions in observed phase");
+                self.reasons.take();
+                let index = self.trainer.select_action(&game, &actions, &mut rng)?;
+                let action = *actions.get(index).context("trainer action index outside candidates")?;
+                cancel.check()?;
+                let mut decision = self.trainer.last_decision().unwrap_or_else(|| fallback_decision(&actions, index, &game.stage));
+                decision.decision_kind = ramen_stage_kind(game.stage.clone()).into();
+                let mut extra = decision.scenario_extra.take().unwrap_or_else(|| json!({}));
+                extra["score_type"] = if decision.candidate_scores.is_empty() { "none" } else { "terminal_score" }.into();
+                if extra.get("decision_source").is_none() { extra["decision_source"] = if decision.candidate_scores.is_empty() { "handwritten" } else { "mcts" }.into(); }
+                decision.scenario_extra = Some(extra);
+                if !decision.candidate_scores.is_empty() {
+                    let capture = Arc::new(Capture::default());
+                    let target: Arc<dyn DecisionSink> = capture.clone();
+                    let kind = decision.decision_kind.clone();
+                    emit_with_luck_decision(Some(decision.clone()), &game, &target, &mut next_luck, snapshot.run_id, self.reasons.take().as_ref(), &kind, Some(&action.to_string()));
+                    if let Some(info) = capture.0.lock().map_err(|_| anyhow::anyhow!("capture poisoned"))?.take() { decision = info; }
+                }
+                emit(RuntimeEvent::Decision { decision, view: game.view(), action: Some(action) });
+                if step == 0 && game.stage == RamenStage::RamenSelect && !action.is_eating_ramen() {
+                    game.apply_action(&action, &mut rng)?;
+                    ensure!(game.next() && game.stage == RamenStage::Train, "unexpected deterministic continuation");
+                    emit(RuntimeEvent::NextStep);
+                } else { break; }
+            }
+        }
+        cancel.check()?;
+        emit(RuntimeEvent::Completed);
+        self.luck = next_luck;
+        self.previous = Some((snapshot.run_id, snapshot.snapshot_id));
+        self.recovery_baseline = partial_history;
+        self.luck_start = Some((snapshot.run_id, luck_start));
+        self.previous_turn = Some(snapshot.state.base_game.turn);
+        self.collector.commit(snapshot.run_id, instance, snapshot.snapshot_id);
+        Ok(response)
+    }
+}
