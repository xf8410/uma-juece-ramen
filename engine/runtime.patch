+        let first = a.evaluate_json(&raw, 42, CancellationToken::new())?;
+        let second = b.evaluate_json(&raw, 42, CancellationToken::new())?;
+        checks.check(serde_json::to_value(&first)? == serde_json::to_value(&second)?, "same input and seed reproduces complete structured output");
+        checks.check(a.evaluate_json(&raw, 42, CancellationToken::new()).is_err(), "duplicate snapshot is rejected");
+        let token = CancellationToken::new(); token.cancel();
+        checks.check(b.evaluate_json(&raw, 42, token).is_err(), "pre-cancelled request rejected");
+        let mut event = snapshot(); event.snapshot_id = 2; event.stage = "event".into();
+        event.state.base_game.source = Some("event".into());
+        event.state.base_game.playing_state = 5;
+        event.event = Some(EventData { id: 9, name: "test".into(), player_select: true, choices: vec![vec![EventChoice { prob: 100, value: ActionValue { status_pt: [10;6], ..Default::default() }, ..Default::default() }], vec![EventChoice { prob: 100, value: ActionValue { status_pt: [1;6], ..Default::default() }, ..Default::default() }]], ..Default::default() });
+        let mut streamed = Vec::new();
+        let out = a.evaluate_json_with_sink(&serde_json::to_string(&event)?, 42, CancellationToken::new(), &mut |ev| streamed.push(serde_json::to_value(ev).ok()))?;
+        checks.check(streamed.len() == out.events.len(), "stream publishes every response event");
+        checks.check(out.events.iter().any(|e| matches!(e, RuntimeEvent::Decision { decision, action: None, .. } if decision.decision_kind == "event" && decision.action_index == 0)), "event choice uses the shared policy and explicit outcomes");
+        let mut settlement = snapshot(); settlement.snapshot_id = 3; settlement.stage = "settlement".into();
+        let out = a.evaluate_json(&serde_json::to_string(&settlement)?, 42, CancellationToken::new())?;
+        checks.check(out.events.iter().any(|e| matches!(e, RuntimeEvent::Skipped { .. })), "settlement emits skip without invented action");
+        // Every action phase must produce structured output, including stages omitted by legacy PC.
+        for (seq, phase, turn) in [(4, "region_select", 2), (5, "super_ramen_select", 71), (6, "special_select", 10), (7, "ramen_select", 10)] {
+            let mut observed = snapshot(); observed.snapshot_id = seq; observed.stage = phase.into();
+            observed.state.base_game.turn = turn;
+            if phase == "super_ramen_select" { observed.state.base_game.playing_state = 48; }
+            observed.state.ramen.selected_regions = vec![0, 1, 2];
+            if phase == "special_select" {
+                observed.continuation.pending_ramen = Some(0);
+                observed.state.ramen.feeling_stock = vec![1, 1, 2, 2, 3, 3];
+                observed.state.ramen.special_feeling = 2;
+            }
+            let result = a.evaluate_json(&serde_json::to_string(&observed)?, 42, CancellationToken::new())?;
+            checks.check(result.events.iter().any(|e| matches!(e, RuntimeEvent::Decision { decision, .. } if decision.decision_kind == phase)), &format!("structured {phase} decision"));
+            if phase == "ramen_select" {
+                let order: Vec<&str> = result.events.iter().map(|e| match e { RuntimeEvent::Started => "start", RuntimeEvent::Decision { .. } => "decision", RuntimeEvent::NextStep => "next", RuntimeEvent::Completed => "done", RuntimeEvent::Skipped { .. } => "skip" }).collect();
+                checks.check(order == ["start", "decision", "next", "decision", "done"], "no-eat chain streams first decision before follow-up");
+            }
+        }
+        let game = snapshot().into_game()?;
+        let actions = game.list_actions()?;
+        let group_cancel = CancellationToken::new();
+        let control = group_cancel.clone();
+        let search = umasim::search::FlatSearch::<RamenGame>::new(SearchConfig::default().with_search_n(8)).with_cancellation(group_cancel);
+        let search_result = search.search_with(&game, &actions, &mut StdRng::seed_from_u64(42), |_, _, _| {
+            control.cancel();
+            Ok(umasim::search::SearchScore { score: 1.0, score_pt: 1.0 })
+        });
+        checks.check(search_result.is_err(), "cancellation inside rollout invalidates entire search group");
+        // Cancel during a real search. Every rollout checks the shared handle.
+        let mut cancelled = RamenSession::new(config.clone())?;
+        let token = CancellationToken::new();
+        let other = token.clone();
+        let outcome = cancelled.evaluate_json_with_sink(&raw, 42, token, &mut |event| { if matches!(event, RuntimeEvent::Started) { other.cancel(); } });
+        checks.check(outcome.is_err(), "stream-start cancellation suppresses all decisions");
+        let mut recovery = RamenSession::new(config.clone())?;
+        let mut recovered = serde_json::to_value(snapshot())?;
+        recovered["schema_version"] = json!(2); recovered["collector_instance_id"] = json!("boot-a");
+        checks.check(recovery.evaluate_json(&recovered.to_string(), 42, CancellationToken::new()).is_err(), "V2 runtime requires handshake before search");
+        recovery.select_collector_instance("boot-a")?;
+        let first = recovery.evaluate_json(&recovered.to_string(), 42, CancellationToken::new())?;
+        recovery.select_collector_instance("boot-b")?;
+        recovered["collector_instance_id"] = json!("boot-b");
+        let resumed = recovery.evaluate_json(&recovered.to_string(), 42, CancellationToken::new())?;
+        checks.check(first.snapshot_id == resumed.snapshot_id && first.collector_instance_id != resumed.collector_instance_id, "same-run same-sequence restart accepted only after explicit new epoch");
+        checks.check(resumed.warnings.iter().any(|v| v.starts_with("luck_baseline_at_recovery")), "new baseline never presented as uninterrupted history");
+        recovered["collector_instance_id"] = json!("boot-a"); recovered["snapshot_id"] = json!(999);
+        checks.check(recovery.evaluate_json(&recovered.to_string(), 42, CancellationToken::new()).is_err(), "late old epoch is rejected by actual evaluation");
+        let mut continuity = RamenSession::new(config.clone())?;
+        continuity.select_collector_instance("continuous")?;
+        let mut observed = serde_json::to_value(snapshot())?;
+        observed["schema_version"] = json!(2); observed["collector_instance_id"] = json!("continuous");
+        continuity.evaluate_json(&observed.to_string(), 42, CancellationToken::new())?;
+        observed["snapshot_id"] = json!(2); observed["ready"] = json!(false);
+        checks.check(continuity.evaluate_json(&observed.to_string(), 42, CancellationToken::new()).is_err(), "incomplete intermediate snapshot does not commit a watermark");
+        observed["snapshot_id"] = json!(3); observed["ready"] = json!(true);
+        let gap = continuity.evaluate_json(&observed.to_string(), 42, CancellationToken::new())?;
+        checks.check(gap.warnings.iter().any(|w| w.starts_with("snapshot_sequence_gap")), "same-turn sequence gap has explicit history warning");
+        checks.check(gap.events.iter().any(|event| matches!(event, RuntimeEvent::Decision { decision, .. }
+            if decision.scenario_extra.as_ref().is_some_and(|extra| extra["history_complete"] == false && extra["luck_segment_start_snapshot_id"] == 3))),
+            "complete current state still computes with a new luck baseline after gap");
+        let mut recompute = RamenSession::new(config)?; recompute.select_collector_instance("continuous")?;
+        let fresh = recompute.evaluate_json(&observed.to_string(), 42, CancellationToken::new())?;
+        checks.check(!fresh.warnings.iter().any(|w| w.starts_with("snapshot_sequence_gap")), "new configuration/session recomputation has no invented previous sequence");
+        checks.finish()
+    }
+}
