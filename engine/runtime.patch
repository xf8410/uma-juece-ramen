+        let parsed = decisions::parse(pack.decisions_csv.as_deref())?;
+        let history = analyze(&pack, &parsed.rows)?.context("missing history")?;
+        ensure!(history.luck_segments.len() == 2, "distinct configurations were merged");
+        ensure!(history.boundary_turns.is_empty(), "configuration comparison was mislabeled as missing game history");
+        ensure!(history.luck_segments.iter().all(|segment| segment.luck.series.len() == 1), "a segment contains another request's scores");
+        ensure!(history.decisions.len() == 2 && history.decisions[0].config_id == "cfg-a" && history.decisions[1].config_id == "cfg-b", "decision/config mapping lost");
+        ensure!(history.luck_segments.iter().all(|segment| segment.decision_rows.len() == 1 && segment.decision_indices.len() == 1), "renderer would mix requests sharing one file");
+        Ok(())
+    }
+
+    /// Reusing a request ID for a different computation generation is invalid even on the same capture.
+    #[test]
+    fn request_id_cannot_change_configuration_and_native_versions_require_all_ids() -> Result<()> {
+        let csv = "file,turn,seq,outcome,snapshot_schema_version,collector_instance_id,snapshot_id,request_id,config_id,luck_segment_start_snapshot_id,history_complete,total_luck\ngame991_turn10_1.json,10,1,calc,2,boot-a,1,req-a,cfg-a,1,false,100\ngame991_turn10_1.json,10,1,calc,2,boot-a,1,req-a,cfg-b,1,false,200\n";
+        let pack = one_capture(csv);
+        let parsed = decisions::parse(pack.decisions_csv.as_deref())?;
+        ensure!(analyze(&pack, &parsed.rows).is_err(), "request ID was silently rebound");
+        ensure!(recorded_configuration_ids(csv)?.len() == 2, "historical configurations were collapsed");
+        ensure!(recorded_configuration_ids("outcome,config_id\ncalc,\n").is_err(), "missing generation accepted");
+        ensure!(recorded_configuration_ids("outcome,config_id\nskip,\n")?.is_empty(), "skip invented a computation generation");
+        Ok(())
+    }
+
+    /// The original V1 protocol permits sequence zero; V2's positive-sequence rule must not leak into it.
+    #[test]
+    fn legacy_v1_zero_sequence_baseline_remains_valid() -> Result<()> {
+        let mut pack = one_capture("file,turn,seq,outcome,snapshot_schema_version,collector_instance_id,snapshot_id,request_id,config_id,luck_segment_start_snapshot_id,history_complete,total_luck\ngame991_turn10_1.json,10,1,calc,1,legacy-v1,0,req-a,cfg-a,0,false,100\n");
+        let mut state: Value = serde_json::from_slice(&pack.snaps[0].bytes)?;
+        state["runtime_schema_version"] = json!(1); state["runtime_collector_instance_id"] = json!(LEGACY_COLLECTOR_INSTANCE); state["runtime_snapshot_id"] = json!(0);
+        pack.snaps[0].bytes = serde_json::to_vec(&state)?;
+        let parsed = decisions::parse(pack.decisions_csv.as_deref())?;
+        let history = analyze(&pack, &parsed.rows)?.context("missing history")?;
+        ensure!(history.luck_segments[0].start_snapshot_id == Some(0), "V1 zero baseline rejected or normalized");
+        Ok(())
+    }
+
+    /// A same-turn source sequence gap is missing observation history, not a reason to merge luck baselines.
+    #[test]
+    fn same_epoch_sequence_gap_is_a_recovery_boundary() -> Result<()> {
+        let mut pack = one_capture("file,turn,seq,outcome,snapshot_schema_version,collector_instance_id,snapshot_id,request_id,config_id,luck_segment_start_snapshot_id,history_complete,total_luck\ngame991_turn10_1.json,10,1,calc,2,boot-a,1,req-a,cfg-a,1,false,100\ngame991_turn10_2.json,10,2,calc,2,boot-a,3,req-b,cfg-a,3,false,0\n");
+        let mut second = pack.snaps[0].clone(); second.seq = 2; second.file = "game991_turn10_2.json".into();
+        let mut state: Value = serde_json::from_slice(&second.bytes)?; state["runtime_snapshot_id"] = json!(3); second.bytes = serde_json::to_vec(&state)?;
+        pack.snaps.push(second);
+        let parsed = decisions::parse(pack.decisions_csv.as_deref())?;
+        let history = analyze(&pack, &parsed.rows)?.context("missing history")?;
+        ensure!(history.boundary_turns == [10] && history.luck_segments.len() == 2 && !history.history_complete, "same-turn missing observation was hidden");
+        Ok(())
+    }
+
+    /// Same source sequence in two epochs is safe only with distinct durable archive identities.
+    #[test]
+    fn same_sequence_across_epochs_joins_by_archive_key() -> Result<()> {
+        let snap = |instance: &str, archive_seq: u32| SnapEntry { file: format!("game991_turn10_{archive_seq}.json"), game: 991, turn: 10, seq: archive_seq,
+            bytes: json!({"runtime_schema_version":2,"runtime_collector_instance_id":instance,"runtime_snapshot_id":1,
+                "baseGame":{"single_mode_chara_id":991}}).to_string().into_bytes() };
+        let mut pack = Pack { snaps: vec![snap("boot-a", 1), snap("boot-b", 2)], ..Default::default() };
+        pack.decisions_csv = Some("file,turn,seq,outcome,snapshot_schema_version,collector_instance_id,snapshot_id,config_id,luck_segment_start_snapshot_id,history_complete,total_luck\ngame991_turn10_1.json,10,1,calc,2,boot-a,1,cfg,1,false,100\ngame991_turn10_2.json,10,2,calc,2,boot-b,1,cfg,1,false,0\n".into());
+        let parsed = decisions::parse(pack.decisions_csv.as_deref())?;
+        let history = analyze(&pack, &parsed.rows)?.context("recovery history missing")?;
+        ensure!(history.luck_segments.len() == 2 && !history.history_complete, "epochs were merged into one luck baseline");
+        pack.snaps[1].seq = 1;
+        ensure!(analyze(&pack, &parsed.rows).is_err(), "archive key collision was accepted");
+        pack.snaps[1].seq = 2;
+        pack.decisions_csv = pack.decisions_csv.map(|text| text.replace(",2,boot-b,1,", ",2,boot-a,1,"));
+        ensure!(analyze(&pack, &parsed.rows).is_err(), "CSV epoch mismatch was accepted");
+        println!("[OK] distinct archive identity, segmented luck, collision and CSV mismatch rejection");
+        Ok(())
+    }
+}
