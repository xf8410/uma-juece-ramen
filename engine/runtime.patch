+        let csv = "file,turn,seq,outcome,snapshot_schema_version,collector_instance_id,snapshot_id,config_id,luck_segment_start_snapshot_id,history_complete,total_luck\ngame991_turn71_1.json,71,1,calc,2,boot-a,1,cfg,1,false,100\ngame991_turn71_2.json,71,2,calc,2,boot-b,1,cfg,1,false,0\n";
+        fs::write(dir.join("decisions.csv"), csv)?;
+        fs::create_dir_all(dir.join("envelopes/boot-a"))?;
+        fs::write(dir.join("envelopes/boot-a/meta.json"), br#"{"game":777,"complete":true}"#)?;
+        let multi_zip = dir.join("recovery.zip");
+        let mut zip = ZipWriter::new(fs::File::create(&multi_zip)?);
+        for (file, bytes) in [(name, a.as_slice()), (second_name, b.as_slice()), ("decisions.csv", csv.as_bytes()), ("meta.json", meta.as_slice()),
+            ("envelopes/boot-a/meta.json", br#"{"game":777,"complete":true}"#.as_slice())] {
+            zip.start_file(file, SimpleFileOptions::default())?; zip.write_all(bytes)?;
+        }
+        zip.finish()?;
+        let recovered_html = analyze_pack(&dir, &dir.join("recovered-directory"), &root.join("gamedata"))?;
+        analyze_pack(&multi_zip, &dir.join("recovered-zip"), &root.join("gamedata"))?;
+        let recovered_bytes = fs::read(dir.join("recovered-directory/digest.json"))?;
+        ensure!(recovered_bytes == fs::read(dir.join("recovered-zip/digest.json"))?, "V2 directory/ZIP facts diverged");
+        let recovered: serde_json::Value = serde_json::from_slice(&recovered_bytes)?;
+        ensure!(recovered["recovery"]["luck_segments"].as_array().is_some_and(|s| s.len() == 2), "distinct process baselines were merged");
+        ensure!(recovered["meta"]["total_luck_end"].is_null(), "recovery segment mislabeled as whole-run luck");
+        ensure!(recovered["meta"]["game"] == 991, "nested envelope shadowed canonical metadata");
+        let recovered_report = fs::read_to_string(recovered_html)?;
+        ensure!(recovered_report.contains("独立运气段 2") && recovered_report.contains("本段运气分"), "segmented HTML chart missing");
+        fs::write(dir.join("decisions.csv"), csv.replace(",2,boot-b,1,", ",2,boot-x,1,"))?;
+        ensure!(analyze_pack(&dir, &dir.join("invalid-identity"), &root.join("gamedata")).is_err(), "CSV/epoch identity mismatch reached review");
+        let legacy = dir.join("decision_log.jsonl"); fs::write(&legacy, "{}")?;
+        ensure!(analyze_pack(&legacy, &dir.join("legacy"), &root.join("gamedata")).is_err(), "legacy summary accepted as complete history");
+        println!("[OK] native directory/ZIP parity, explicit stage, local narrative, cwd isolation, legacy rejection; evidence {}", dir.display());
+        Ok(())
+    }
+}
