new file mode 100644
index 0000000..c2b5dbf
--- /dev/null
+++ b/crates/umaai_review/src/recovery.rs
@@ -0,0 +1,332 @@
+//! Process-aware archive identity and luck segments. Legacy PC packs remain readable.
+use std::collections::{BTreeMap, HashMap, HashSet};
+use anyhow::{Context, Result, ensure};
+use serde::Serialize;
+use serde_json::Value;
+use umaai_runtime::{LEGACY_COLLECTOR_INSTANCE, validate_collector_instance_id};
+use crate::{decisions::{self, DecRow, LuckBlock}, digest::Digest, pack::Pack};
+
+/// Explicit mapping from the durable archive key to the collector's wire identity.
+#[derive(Debug, Clone, Serialize)]
+pub struct SnapshotLink {
+    pub file: String,
+    pub run_id: u64,
+    pub turn: u32,
+    pub archive_seq: u32,
+    pub schema_version: u32,
+    pub collector_instance_id: String,
+    pub snapshot_id: Option<u64>,
+}
+
+/// Exact binding for one decision row; several requests may evaluate the same immutable capture.
+#[derive(Debug, Clone, Serialize)]
+pub struct DecisionLink {
+    pub decision_index: usize,
+    pub capture: SnapshotLink,
+    pub request_id: Option<String>,
+    pub config_id: String,
+    pub start_snapshot_id: Option<u64>,
+    pub history_complete: Option<bool>,
+}
+
+/// Independent live-computation baseline. Values from separate segments cannot be accumulated.
+#[derive(Debug, Serialize)]
+pub struct LuckSegment {
+    pub collector_instance_id: String,
+    pub start_snapshot_id: Option<u64>,
+    pub config_id: String,
+    pub history_complete: Option<bool>,
+    pub first_archive_seq: u32,
+    pub files: Vec<String>,
+    /// Ordinals into digest.decisions, independent of a potentially repeated source filename.
+    pub decision_indices: Vec<usize>,
+    /// Rendering uses only this segment's exact rows, not a filename join across configurations.
+    #[serde(skip)]
+    pub decision_rows: Vec<DecRow>,
+    pub luck: LuckBlock,
+}
+
+/// Identity evidence retained in digest.json, including unverified historical continuity.
+#[derive(Debug, Default, Serialize)]
+pub struct RecoveryHistory {
+    pub snapshots: Vec<SnapshotLink>,
+    pub luck_segments: Vec<LuckSegment>,
+    pub history_complete: bool,
+    pub boundary_turns: Vec<u32>,
+    pub csv_identity_from_legacy_filename: bool,
+    pub decisions: Vec<DecisionLink>,
+}
+
+/// Parse the new native archive extensions and verify CSV-to-snapshot joins before analysis.
+pub fn analyze(pack: &Pack, decisions: &[DecRow]) -> Result<Option<RecoveryHistory>> {
+    let mut links = Vec::new();
+    let mut modern = false;
+    for snap in &pack.snaps {
+        let Ok(raw) = serde_json::from_slice::<Value>(&snap.bytes) else { continue; };
+        let version = match raw.get("runtime_schema_version") {
+            Some(value) => value.as_u64().context("invalid archived snapshot version")?,
+            None => 1,
+        };
+        ensure!(version == 1 || version == 2, "unsupported archived snapshot version");
+        modern |= raw.get("runtime_schema_version").is_some();
+        let instance = if version == 2 {
+            let id = raw["runtime_collector_instance_id"].as_str().context("archive collector instance missing")?;
+            validate_collector_instance_id(id)?;
+            id.to_string()
+        } else { LEGACY_COLLECTOR_INSTANCE.into() };
+        let source_id = raw["runtime_snapshot_id"].as_u64();
+        if version == 2 {
+            ensure!(source_id.is_some_and(|n| n > 0), "archive source snapshot identity missing");
+            ensure!(raw["baseGame"]["single_mode_chara_id"].as_u64() == Some(snap.game), "archive run identity mismatch");
+        }
+        links.push(SnapshotLink { file: snap.file.clone(), run_id: snap.game, turn: snap.turn, archive_seq: snap.seq,
+            schema_version: version as u32, collector_instance_id: instance, snapshot_id: source_id });
+    }
+    if !modern { return Ok(None); }
+    let mut archive_keys = HashSet::new();
+    let mut wire_keys = HashSet::new();
+    let mut watermarks = HashMap::new();
+    let mut retired = HashSet::new();
+    let mut current: Option<&str> = None;
+    let mut previous_turn: Option<u32> = None;
+    let mut boundary_turns = Vec::new();
+    for link in &links {
+        ensure!(link.run_id == pack.game || pack.game == 0, "mixed runs in native archive");
+        ensure!(archive_keys.insert((link.turn, link.archive_seq)), "archive key collision: turn={} seq={}", link.turn, link.archive_seq);
+        if let Some(source) = link.snapshot_id {
+            ensure!(wire_keys.insert((link.run_id, link.collector_instance_id.clone(), source)), "duplicate source snapshot in archive");
+            let key = (link.run_id, link.collector_instance_id.clone());
+            ensure!(watermarks.get(&key).is_none_or(|&previous| source > previous), "source sequence regressed within collector epoch");
+            if watermarks.get(&key).is_some_and(|&previous| source.checked_sub(previous) != Some(1)) { boundary_turns.push(link.turn); }
+            watermarks.insert(key, source);
+        }
+        if current != Some(link.collector_instance_id.as_str()) {
+            ensure!(!retired.contains(link.collector_instance_id.as_str()), "retired collector epoch reappears in archive");
+            if let Some(old) = current { retired.insert(old); boundary_turns.push(link.turn); }
+            current = Some(&link.collector_instance_id);
+        }
+        if previous_turn.is_some_and(|turn| link.turn > turn.saturating_add(1)) { boundary_turns.push(link.turn); }
+        previous_turn = Some(link.turn);
+    }
+    let by_file: HashMap<&str, &SnapshotLink> = links.iter().map(|link| (link.file.as_str(), link)).collect();
+    // Bind calc rows by CSV ordinal and request identity. A filename denotes a capture, not a computation.
+    let mut bindings: Vec<Option<DecisionLink>> = Vec::new();
+    let mut requests: HashMap<String, (String, String, Option<u64>, Option<bool>)> = HashMap::new();
+    let mut csv_identity_from_legacy_filename = false;
+    if let Some(csv) = &pack.decisions_csv {
+        let mut reader = csv::Reader::from_reader(csv.as_bytes());
+        let headers = reader.headers()?.clone();
+        for row in reader.records() {
+            let row = row?;
+            let get = |name: &str| headers.iter().position(|h| h == name).and_then(|i| row.get(i)).filter(|v| !v.is_empty());
+            let file = get("file").unwrap_or_default();
+            let is_decision = get("outcome") == Some("calc");
+            let Some(link) = by_file.get(file) else {
+                ensure!(get("snapshot_schema_version") != Some("2"), "V2 decision references missing canonical snapshot: {file}");
+                if is_decision { bindings.push(None); }
+                continue;
+            };
+            if link.schema_version == 2 {
+                ensure!(get("seq").and_then(|s| s.parse::<u32>().ok()) == Some(link.archive_seq)
+                    && get("turn").and_then(|s| s.parse::<u32>().ok()) == Some(link.turn), "decision/archive identity mismatch: {file}");
+                if headers.iter().any(|name| matches!(name, "snapshot_schema_version" | "collector_instance_id" | "snapshot_id")) {
+                    ensure!(get("snapshot_schema_version") == Some("2")
+                        && get("collector_instance_id") == Some(link.collector_instance_id.as_str())
+                        && get("snapshot_id").and_then(|s| s.parse::<u64>().ok()) == link.snapshot_id, "decision/archive identity mismatch: {file}");
+                } else {
+                    // Historical PC recorders key CSV by filename/(turn,seq). The unique canonical
+                    // state carries V2 identity; record the fallback rather than inventing CSV fields.
+                    csv_identity_from_legacy_filename = true;
+                }
+            }
+            // A terminal/cancellation/skip row has no scoring baseline; it still passed identity validation above.
+            if !is_decision { continue; }
+            let start = get("luck_segment_start_snapshot_id").map(str::parse::<u64>).transpose().context("invalid luck baseline identity")?;
+            let complete = get("history_complete").map(str::parse::<bool>).transpose().context("invalid history_complete")?;
+            let config = get("config_id").unwrap_or_default().to_string();
+            let request = get("request_id").map(str::to_string);
+            if let (Some(start), Some(source)) = (start, link.snapshot_id) {
+                ensure!((link.schema_version == 1 || start > 0) && start <= source, "invalid future luck baseline");
+            }
+            if let Some(request) = &request {
+                let identity = (file.to_string(), config.clone(), start, complete);
+                if let Some(old) = requests.insert(request.clone(), identity.clone()) {
+                    ensure!(old == identity, "request identity or chained decision baseline mismatch");
+                }
+            }
+            bindings.push(Some(DecisionLink { decision_index: bindings.len(), capture: (*link).clone(), request_id: request,
+                config_id: config, start_snapshot_id: start, history_complete: complete }));
+        }
+    }
+    ensure!(bindings.len() == decisions.len(), "decision CSV ordinal mismatch");
+    let mut grouped: BTreeMap<(String, Option<u64>, String, String), (Option<bool>, Vec<(usize, DecRow)>)> = BTreeMap::new();
+    for (index, row) in decisions.iter().enumerate() {
+        let Some(binding) = &bindings[index] else { continue; };
+        let link = &binding.capture;
+        ensure!(row.file == link.file && row.turn == link.turn && row.seq == link.archive_seq, "decision row differs from its capture binding");
+        let (instance, start, config, complete) = (link.collector_instance_id.clone(), binding.start_snapshot_id,
+            binding.config_id.clone(), binding.history_complete);
+        // A policy/session change splits luck but does not invent a gap in observed game history.
+        // Missing baseline metadata cannot prove that two decisions share a live session.
+        let unknown_key = if start.is_none() { binding.request_id.clone().unwrap_or_else(|| format!("row-{index}")) } else { String::new() };
+        let segment = grouped.entry((instance, start, config, unknown_key)).or_insert_with(|| (complete, Vec::new()));
+        if segment.0 != complete { segment.0 = None; }
+        segment.1.push((index, row.clone()));
+    }
+    let mut segments: Vec<_> = grouped.into_iter().map(|((instance, start, config, _), (complete, entries))| {
+        let (indices, rows): (Vec<_>, Vec<_>) = entries.into_iter().unzip();
+        LuckSegment {
+            collector_instance_id: instance, start_snapshot_id: start, config_id: config,
+            history_complete: complete, first_archive_seq: rows.iter().map(|r| r.seq).min().unwrap_or(0),
+            files: rows.iter().map(|r| r.file.clone()).collect(), luck: decisions::build_luck(&rows),
+            decision_indices: indices, decision_rows: rows,
+        }
+    }).collect();
+    segments.sort_by_key(|segment| segment.first_archive_seq);
+    boundary_turns.sort_unstable(); boundary_turns.dedup();
+    let complete = boundary_turns.is_empty() && links.first().is_some_and(|link| link.turn == 0)
+        && segments.len() == 1 && segments[0].start_snapshot_id.is_some() && segments[0].history_complete == Some(true);
+    Ok(Some(RecoveryHistory { snapshots: links, luck_segments: segments, history_complete: complete, boundary_turns,
+        csv_identity_from_legacy_filename, decisions: bindings.into_iter().flatten().collect() }))
+}
+
+/// Native review needs version evidence for every configuration that produced a decision row.
+pub fn recorded_configuration_ids(csv: &str) -> Result<HashSet<String>> {
+    let mut reader = csv::Reader::from_reader(csv.as_bytes());
+    let headers = reader.headers()?.clone();
+    let outcome = headers.iter().position(|name| name == "outcome");
+    let config = headers.iter().position(|name| name == "config_id");
+    let mut result = HashSet::new();
+    for row in reader.records() {
+        let row = row?;
+        if outcome.and_then(|index| row.get(index)) != Some("calc") { continue; }
+        let id = config.and_then(|index| row.get(index)).filter(|id| !id.is_empty()).context("review_decision_configuration_missing")?;
+        result.insert(id.to_string());
+    }
+    Ok(result)
+}
+
+/// Apply recovery limitations consistently to native and PC review outputs.
+pub fn apply(digest: &mut Digest, pack: &Pack) -> Result<()> {
+    let Some(mut history) = analyze(pack, &digest.decisions)? else { return Ok(()); };
+    for segment in &mut history.luck_segments {
+        segment.luck.flagged_turns = digest.luck.flagged_turns.clone();
+    }
+    if history.csv_identity_from_legacy_filename {
+        digest.context.criteria.push("旧CSV缺采集身份列，已按唯一标准快照文件名及归档序号关联；没有补造原始序号或运气基线。".into());
+    }
+    if !history.history_complete {
+        digest.meta.total_luck_end = None;
+        // Keep individual segment curves below; a single joined curve invents continuity across resets.
+        digest.luck = LuckBlock::default();
+        digest.context.criteria.push("采集或计算恢复后的运气分按独立基线分段，不代表整局累计；缺少前史不会阻止完整当前快照继续决策。".into());
+    }
+    if !history.boundary_turns.is_empty() {
+        let uncertain = |turn: u32| history.boundary_turns.iter().any(|&boundary| turn == boundary || turn.saturating_add(1) == boundary);
+        digest.execution.retain(|row| !uncertain(row.turn));
+        digest.findings.retain(|row| !uncertain(row.turn));
+        // These legacy aggregates assume one uninterrupted stream. Preserve source snapshots and mark unavailable.
+        digest.inherit = None;
+        digest.clones = None;
+        digest.context.criteria.push("记录存在恢复边界；边界附近不推断真实操作，本报告不生成依赖连续历史的继承及分身汇总。".into());
+    }
+    digest.recovery = Some(history);
+    Ok(())
+}
+
