<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮窗 v0.3.7 视觉改进：圆角卡片底、分区留白、字号层级、警告独立成条 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:paddingLeft="9dp"
    android:paddingRight="9dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <!-- 行1：回合 + 决策源 -->
    <TextView
        android:id="@+id/tv_turn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="等待数据"
        android:textColor="#FFC66D"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.02" />

    <!-- 候选条形图（v0.3.2）：Rust decision 喂图，无候选时 GONE 不占空间 -->
    <com.umaai.assistant.service.BoardChartsView
        android:id="@+id/chart_candidates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <!-- 行2：行动/训练建议（主信息，放大） -->
    <TextView
        android:id="@+id/tv_recommend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="1dp"
        android:text="等待行动建议"
        android:textColor="#66FFAA"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- 行3：校正警告（独立条，v0.3.7 从建议行拆出；无警告 GONE） -->
    <TextView
        android:id="@+id/tv_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_warn"
        android:lineSpacingExtra="1dp"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textColor="#FFD180"
        android:textSize="9sp"
        android:visibility="gone" />

    <!-- 行4：状态数字 -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="1dp"
        android:textColor="#E8E8E8"
        android:textSize="10sp" />

    <!-- 行5：拉面状态 -->
    <TextView
        android:id="@+id/tv_ramen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="1dp"
        android:textColor="#FFBB66"
        android:textSize="9sp" />

    <!-- 行6：五训练收益表（monospace 对齐） -->
    <TextView
        android:id="@+id/tv_trainings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:lineSpacingExtra="1dp"
        android:textColor="#D8D8D8"
        android:textSize="9sp" />

    <!-- 行7：数据源脚注 -->
    <TextView
        android:id="@+id/tv_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="等待本地数据"
        android:textColor="#8A8A8A"
        android:textSize="8sp" />

    <TextView
        android:id="@+id/tv_scenario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="拉面"
        android:visibility="gone"
        android:textColor="#FFC66D"
        android:textSize="8sp" />

    <TextView
        android:id="@+id/btn_close"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
</LinearLayout>
