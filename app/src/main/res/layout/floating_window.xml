<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#D9000000"
    android:orientation="vertical"
    android:padding="5dp">

    <TextView
        android:id="@+id/tv_turn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="等待数据"
        android:textColor="#FFAA44"
        android:textSize="10sp"
        android:textStyle="bold" />

    <!-- 候选条形图（v0.3.2）：tv_turn 下方，Rust decision 喂图，
         无候选/评分全 0 时 GONE 不占空间 -->
    <com.umaai.assistant.service.BoardChartsView
        android:id="@+id/chart_candidates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_recommend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="等待行动建议"
        android:textColor="#55FF99"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/tv_ramen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:textColor="#FFBB66"
        android:textSize="8sp" />

    <TextView
        android:id="@+id/tv_trainings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textColor="#DDDDDD"
        android:textSize="8sp" />

    <TextView
        android:id="@+id/tv_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="等待本地数据"
        android:textColor="#777777"
        android:textSize="7sp" />

    <TextView
        android:id="@+id/tv_scenario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="拉面"
        android:visibility="gone"
        android:textColor="#FFAA44"
        android:textSize="7sp" />

    <TextView
        android:id="@+id/btn_close"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
</LinearLayout>
