<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_root"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="#E6000000"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/tv_turn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="等待数据" android:textColor="#AAAAAA" android:textSize="10sp" />
        <TextView android:id="@+id/tv_scenario" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="拉面杯" android:textColor="#FFAA44" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/btn_close" android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:text="×" android:textColor="#AAAAAA" android:textSize="18sp" />
    </LinearLayout>

    <TextView android:id="@+id/tv_recommend" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="3dp" android:text="等待 hlpatch /summary" android:textColor="#00FF88" android:textSize="12sp" android:textStyle="bold" />
    <TextView android:id="@+id/tv_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="10sp" />
    <TextView android:id="@+id/tv_ramen" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:text="" android:textColor="#FFAA44" android:textSize="9sp" />
    <TextView android:id="@+id/tv_trainings" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:paddingTop="4dp" android:text="" android:textColor="#CCCCCC" android:textSize="9sp" />
    <TextView android:id="@+id/tv_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:text="18766等待推送 / 18765兜底轮询" android:textColor="#666666" android:textSize="8sp" />
</LinearLayout>
