 use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
 use std::sync::Mutex;
 
+// One immutable publication is shared by polling and push. Only the fresh
+// summary capture path updates it; HTTP readers cannot mint new snapshot IDs.
+static RAMEN_AI_OBSERVATIONS: std::sync::OnceLock<Mutex<ramen_observation::Publisher>> =
+    std::sync::OnceLock::new();
+
+/// Publish verified legacy measurements with explicit gaps. This does not mark
+/// an incomplete summary as a decision-ready runtime snapshot.
+fn observe_ai_snapshot(summary: &str) {
+    let captured_at_ms = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|v| v.as_millis() as u64).unwrap_or(0);
+    if let Ok(mut publisher) = RAMEN_AI_OBSERVATIONS
+        .get_or_init(|| Mutex::new(ramen_observation::Publisher::default())).lock() {
+        let _ = publisher.observe_summary(summary, PLUGIN_VERSION, captured_at_ms);
+    }
+}
+
+/// Return the same versioned observation to polling and push consumers.
+fn read_ai_snapshot() -> String {
+    let summary = read_summary();
+    observe_ai_snapshot(&summary);
+    if let Ok(publisher) = RAMEN_AI_OBSERVATIONS
+        .get_or_init(|| Mutex::new(ramen_observation::Publisher::default())).lock() {
+        if let Some(snapshot) = publisher.current() { return snapshot.to_string(); }
+    }
+    r#"{"schema_version":1,"ready":false,"missing_fields":["capture"],"error":"no_snapshot"}"#.into()
+}
