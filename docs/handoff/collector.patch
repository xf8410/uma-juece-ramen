+        names.push(il2cpp_c_string(get_name(current)));
+        namespace = il2cpp_c_string(get_namespace(current));
+        current = get_declaring(current);
+    }
+    names.reverse();
+    let chain = names.join("/");
+    if namespace.is_empty() { chain } else { format!("{}.{}", namespace, chain) }
