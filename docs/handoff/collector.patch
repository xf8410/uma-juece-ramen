+}
+#[test]fn native_crash_handling_remains_owned_by_host(){
+ init_crash_handler();
+ assert_eq!(SIGNALS.load(Ordering::SeqCst),0,"plugin overrides native signal handlers");
+}
+'''
+        cache = ROOT / '.recovery-cache/tests'
